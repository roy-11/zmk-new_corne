#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    behaviors {
    };

    rgb_encoder: rgb_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&rgb_ug RGB_BRI>, <&rgb_ug RGB_BRD>;
    };

    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <0 43 46 41>;
            layers = <3>;
        };

        sys_reset {
            bindings = <&sys_reset>;
            key-positions = <43 46 28 13>;
            layers = <3>;
        };

        studio_unlock {
            bindings = <&studio_unlock>;
            key-positions = <12 43 46 28>;
            layers = <3>;
        };

        bootloader {
            bindings = <&bootloader>;
            key-positions = <46 43 28 27>;
            layers = <3>;
        };

        toggle_usb_blue {
            bindings = <&out OUT_TOG>;
            key-positions = <41 46 43 28>;
            layers = <3>;
        };
    };

    macros {
        copy_mode_in_tmux: copy_mode_in_tmux {
            compatible = "zmk,behavior-macro";
            label = "COPY_MODE_IN_TMUX";
            #binding-cells = <0>;
            bindings = <&kp LC(B) &kp LEFT_BRACKET>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&kp TAB           &kp Q  &kp W  &kp E     &kp R  &kp T                                    &mmv MOVE_UP                     &kp Y       &kp U  &kp I      &kp O    &kp P     &kp BSPC
&kp LEFT_CONTROL  &kp A  &kp S  &kp D     &kp F  &kp G                    &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp H       &kp J  &kp K      &kp L    &kp SEMI  &kp SQT
&kp LEFT_SHIFT    &kp Z  &kp X  &kp C     &kp V  &kp B      &kp C_MUTE                    &mmv MOVE_DOWN                   &kp N       &kp M  &kp COMMA  &kp DOT  &kp FSLH  &kp RIGHT_SHIFT
                                &kp LGUI  &mo 1  &kp SPACE                                                                 &kp RETURN  &mo 2  &kp RALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
        };

        lower_layer {
            display-name = "NUMBER";
            bindings = <
&kp TAB           &kp N1           &kp N2           &kp N3                            &kp N4                            &kp N5                                              &mmv MOVE_UP                     &kp N6         &kp N7         &kp N8         &kp N9     &kp N0              &kp BSPC
&kp LEFT_CONTROL  &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2                      &bt BT_SEL 3                      &bt BT_CLR                          &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp LEFT       &kp DOWN       &kp UP         &kp RIGHT  &copy_mode_in_tmux  &kp DEL
&kp LEFT_SHIFT    &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_COLOR_HSB(148,30,28)  &rgb_ug RGB_COLOR_HSB(220,33,42)  &rgb_ug RGB_TOG  &rgb_ug RGB_TOG                    &mmv MOVE_DOWN                   &kp HOME       &kp PAGE_DOWN  &kp PAGE_UP    &kp END    &none               &kp INSERT
                                                    &kp LEFT_GUI                      &mo 1                             &kp SPACE                                                                            &kp LG(SPACE)  &mo 2          &kp RIGHT_ALT
            >;

            sensor-bindings = <&rgb_encoder>;
        };

        raise_layer {
            display-name = "SYMBOL";
            bindings = <
&kp TAB           &kp EXCL  &kp AT     &kp HASH       &kp DLLR   &kp PRCNT                               &mmv MOVE_UP                     &kp CARET      &kp AMPS   &kp ASTRK      &kp LPAR          &kp RPAR           &kp BSPC
&kp LEFT_CONTROL  &mkp MB4  &mkp LCLK  &mkp MCLK      &mkp RCLK  &mkp MB5                &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp GRAVE      &kp MINUS  &kp PLUS       &kp LEFT_BRACE    &kp RIGHT_BRACE    &kp PIPE
&kp LEFT_SHIFT    &none     &none      &none          &none      &none      &kp SPACE                    &mmv MOVE_DOWN                   &kp TILDE      &kp UNDER  &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
                                       &kp LEFT_META  &mo 1      &kp SPACE                                                                &kp LG(SPACE)  &mo 2      &kp RIGHT_ALT
            >;

            sensor-bindings = <&scroll_encoder>;
        };

        layer_3 {
            display-name = "Fn";
            bindings = <
&caps_word        &kp LS(LG(NUMBER_1))  &kp LS(LG(NUMBER_2))  &kp LS(LG(NUMBER_3))  &kp LS(LG(NUMBER_4))  &kp LS(LG(N5))                               &mmv MOVE_UP                     &kp C_BRI_DEC  &kp C_BRI_INC  &kp K_MUTE     &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &key_repeat
&sk LEFT_CONTROL  &kp F1                &kp F2                &kp F3                &kp F4                &kp F5                       &mmv MOVE_LEFT  &mkp LCLK       &mmv MOVE_RIGHT  &kp F6         &kp F7         &kp F8         &kp F9             &kp F10          &sk RIGHT_CONTROL
&sk LEFT_SHIFT    &kp F11               &kp F12               &kp F13               &kp F14               &kp F15         &kp SPACE                    &mmv MOVE_DOWN                   &kp F16        &kp F17        &kp F18        &kp F19            &kp F20          &sk RIGHT_SHIFT
                                                              &sk LEFT_GUI          &mo 1                 &kp SPACE                                                                     &kp LG(SPACE)  &mo 2          &sk RIGHT_ALT
            >;

            sensor-bindings = <&scroll_encoder>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        chageToLayer3 {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
